# ══════════════════════════════════════════════════════════════
# ENVIRONMENT VARIABLES — KTC HN02 Proxy Server
# ══════════════════════════════════════════════════════════════
# Copy file này thành .env và điền thông tin thật:
#   cp .env.example .env
#
# ⚠️  KHÔNG BAO GIỜ commit file .env lên Git!
#     File .gitignore đã được cấu hình để loại trừ .env
# ══════════════════════════════════════════════════════════════

# Metabase credentials cho auto-login (data-bi.ghn.vn)
# Sử dụng tài khoản service account nếu có, không dùng tài khoản cá nhân
MB_USER=your_email@ghn.vn
MB_PASS=your_password_here

# Port cho proxy server (mặc định: 8888)
# PORT=8888
